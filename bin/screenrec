#!/bin/sh
# screenrec region|output [audio]  -> start recording (ffmpeg x11grab)
# screenrec (again, any args)      -> stop; file goes to ~/Videos/Recordings
#                                     and is copied to the clipboard
set -u
run="${XDG_RUNTIME_DIR:-/tmp}/screenrec-$(id -u)"
notify() { command -v notify-send >/dev/null && notify-send -t 2500 "Screen recording" "$1"; }

# second press: stop the running recording and hand the file over
if [ -f "$run.pid" ] && kill -0 "$(cat "$run.pid")" 2>/dev/null; then
    pid="$(cat "$run.pid")"
    kill -INT "$pid"                       # ffmpeg finalises the mp4 on SIGINT
    i=0
    while kill -0 "$pid" 2>/dev/null; do
        i=$((i + 1)); [ "$i" -eq 100 ] && kill -TERM "$pid"
        sleep 0.1
    done
    file="$(cat "$run.file")"
    rm -f "$run.pid" "$run.file"
    # bar indicator off (quickshell RecState)
    quickshell ipc call rec stopped >/dev/null 2>&1 || true
    if [ -s "$file" ]; then
        # as a file (paste into Discord / a file manager), not raw bytes
        printf 'file://%s\n' "$file" | xclip -selection clipboard -t text/uri-list >/dev/null 2>&1
        notify "Saved to $file (copied to clipboard)"
    else
        rm -f "$file"; notify "Recording failed (see $run.log)"
    fi
    exit 0
fi

mode="${1:-region}"
extra="${2:-}"
dir="$HOME/Videos/Recordings"; mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"

case "$mode" in
    output)  # focused monitor
        geom="$(bspc query -T -m | jq -r '.rectangle | "\(.width) \(.height) \(.x) \(.y)"')" ;;
    *)
        geom="$(slop -f '%w %h %x %y')" || exit 0 ;;   # Esc cancels
esac
set -- $geom
# libx264 + yuv420p need even dimensions
w=$(( $1 / 2 * 2 )); h=$(( $2 / 2 * 2 )); x=$3; y=$4
[ "$w" -gt 0 ] && [ "$h" -gt 0 ] || exit 0

if [ "$extra" = audio ]; then
    # desktop sound = monitor of the default output (not the mic)
    set -- -f pulse -i "$(pactl get-default-sink).monitor" -c:a aac -b:a 160k
else
    set --
fi

grab() { # grab <ffmpeg global opts...> -- <video encoder opts...>
    pre=""; while [ "$1" != "--" ]; do pre="$pre $1"; shift; done; shift
    # shellcheck disable=SC2086 # $pre is a list of plain options
    ffmpeg -nostdin -loglevel error -y $pre \
        -f x11grab -framerate 30 -video_size "${w}x${h}" -i "${DISPLAY}+${x},${y}" \
        $audio "$@" "$file" >>"$run.log" 2>&1 &
    pid=$!
}
audio="$*"   # audio input + codec options (or empty)
: >"$run.log"

# encode on the AMD iGPU (VAAPI): far less CPU and heat than libx264. Its
# render node is found by driver, not by number (an NVIDIA one may come
# first). If VAAPI does not start, fall back to software x264.
vaapi=""
for n in /sys/class/drm/renderD*; do
    [ "$(basename "$(readlink -f "$n/device/driver")")" = amdgpu ] && vaapi="/dev/dri/$(basename "$n")" && break
done
pid=""
if [ -n "$vaapi" ]; then
    grab -vaapi_device "$vaapi" -- -vf "format=nv12,hwupload" -c:v h264_vaapi -qp 24
    sleep 1
    kill -0 "$pid" 2>/dev/null || pid=""
fi
if [ -z "$pid" ]; then
    rm -f "$file"
    grab -- -c:v libx264 -preset veryfast -crf 23 -pix_fmt yuv420p
fi
echo "$pid" > "$run.pid"; echo "$file" > "$run.file"
# bar indicator on: red dot + timer, click stops (quickshell RecState)
quickshell ipc call rec started "$file" >/dev/null 2>&1 || true
notify "Recording... press the same key again to stop"
