#!/usr/bin/env python3
"""Clipboard history for X11 (text only).

  cliphist daemon      watch the CLIPBOARD selection and store new text
                       (started by ~/.config/xmonad/autostart)
  cliphist list        JSON array, newest first: [{id, preview, lines, chars}]
  cliphist copy ID     put entry ID back on the clipboard (moves it to the top)
  cliphist delete ID   forget one entry
  cliphist clear       forget everything

Entries live in ~/.cache/cliphist/<id>.txt (last 200, at most 256 KiB each).
Password managers that mark their copies (x-kde-passwordManagerHint) are
skipped. Uses clipnotify when installed, otherwise polls once a second.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "cliphist")
MAX_ENTRIES = 200
MAX_BYTES = 256 * 1024
TEXT_TARGETS = ("UTF8_STRING", "STRING", "TEXT", "text/plain", "text/plain;charset=utf-8")


def run(args, data=None):
    try:
        r = subprocess.run(args, input=data, capture_output=True, timeout=3)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def read_clipboard():
    targets = run(["xclip", "-selection", "clipboard", "-o", "-t", "TARGETS"])
    if targets is None:
        return None
    targets = targets.decode(errors="replace").split()
    if "x-kde-passwordManagerHint" in targets:
        return None
    if not any(t in targets for t in TEXT_TARGETS):
        return None   # images, files from a file manager, ...
    data = run(["xclip", "-selection", "clipboard", "-o", "-t", "UTF8_STRING"])
    if data is None:
        data = run(["xclip", "-selection", "clipboard", "-o"])
    if not data or not data.strip() or len(data) > MAX_BYTES:
        return None
    return data


def entries():
    """[(id, path)] newest first."""
    try:
        names = [n for n in os.listdir(DIR) if n.endswith(".txt")]
    except FileNotFoundError:
        return []
    names.sort(reverse=True)
    return [(n[:-4], os.path.join(DIR, n)) for n in names]


def store(data):
    os.makedirs(DIR, exist_ok=True)
    digest = hashlib.sha1(data).hexdigest()
    for eid, path in entries():
        try:
            with open(path, "rb") as f:
                if hashlib.sha1(f.read()).hexdigest() == digest:
                    os.remove(path)   # same text again: move it to the top
        except OSError:
            pass
    eid = str(time.time_ns())
    tmp = os.path.join(DIR, eid + ".tmp")
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, os.path.join(DIR, eid + ".txt"))
    for _, path in entries()[MAX_ENTRIES:]:
        try:
            os.remove(path)
        except OSError:
            pass


def daemon():
    last = None
    notify = shutil.which("clipnotify")
    while True:
        if notify:
            if subprocess.run([notify]).returncode != 0:
                time.sleep(1)   # X went away / not up yet
        else:
            time.sleep(1)
        data = read_clipboard()
        if data is not None and data != last:
            last = data
            store(data)


def preview(text):
    one = " ".join(text.split())
    return one[:160] + ("…" if len(one) > 160 else "")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "daemon":
        daemon()
    elif cmd == "list":
        out = []
        for eid, path in entries():
            try:
                with open(path, "rb") as f:
                    text = f.read().decode(errors="replace")
            except OSError:
                continue
            out.append({"id": eid, "preview": preview(text),
                        "lines": text.count("\n") + 1, "chars": len(text)})
        json.dump(out, sys.stdout, ensure_ascii=False)
    elif cmd in ("copy", "delete") and len(sys.argv) > 2:
        eid = os.path.basename(sys.argv[2])
        path = os.path.join(DIR, eid + ".txt")
        if not os.path.isfile(path):
            sys.exit(f"cliphist: no entry {eid}")
        if cmd == "delete":
            os.remove(path)
            return
        with open(path, "rb") as f:
            data = f.read()
        # xclip keeps serving the selection in the background after stdin ends
        subprocess.run(["xclip", "-selection", "clipboard", "-i"], input=data,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        store(data)
    elif cmd == "clear":
        shutil.rmtree(DIR, ignore_errors=True)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
