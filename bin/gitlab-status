#!/usr/bin/env python3
"""Your GitLab merge requests for the bar, as JSON on stdout.

  {"ok": true, "host": "...", "user": "...",
   "mine":   [{"title", "url", "ref", "pipeline", "merge", "draft"}],
   "review": [{"title", "url", "author"}]}
  {"ok": false, "error": "..."}   (glab missing, not logged in, offline)

mine     open MRs you created, with the head pipeline status (success,
         failed, running, pending, ...) and GitLab's detailed merge status
review   open MRs where you are a reviewer

Talks to GitLab through `glab api`, so it uses glab's login:
  glab auth login --hostname gitlab.example.com
The host: $GITLAB_HOST, else ~/.config/dots/gitlab-host (one line), else
glab's default host.
"""
import json
import os
import shutil
import subprocess
import sys
from urllib.parse import quote


def host():
    h = os.environ.get("GITLAB_HOST")
    if h:
        return h
    try:
        with open(os.path.expanduser("~/.config/dots/gitlab-host")) as f:
            return f.read().strip() or None
    except OSError:
        return None


HOST = host()


class Fail(Exception):
    pass


def api(path):
    cmd = ["glab", "api"]
    if HOST:
        cmd += ["--hostname", HOST.removeprefix("https://").removeprefix("http://").rstrip("/")]
    cmd.append(path)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        raise Fail("GitLab did not answer in 30 s")
    if r.returncode != 0:
        msg = (r.stderr or r.stdout).strip().splitlines()
        raise Fail(msg[-1] if msg else f"glab api {path} failed")
    return json.loads(r.stdout)


def main():
    if not shutil.which("glab"):
        raise Fail("glab is not installed")
    user = api("user")
    me = user["username"]
    mine = []
    for mr in api("merge_requests?scope=created_by_me&state=opened&per_page=20"):
        # the list endpoint has no pipeline; the single-MR one does
        try:
            full = api(f"projects/{mr['project_id']}/merge_requests/{mr['iid']}")
        except Fail:
            full = mr
        pipe = full.get("head_pipeline") or full.get("pipeline") or {}
        mine.append({
            "title": mr["title"],
            "url": mr["web_url"],
            "ref": mr.get("references", {}).get("full", f"!{mr['iid']}"),
            "pipeline": pipe.get("status", ""),
            "merge": full.get("detailed_merge_status") or full.get("merge_status", ""),
            "draft": bool(mr.get("draft") or mr.get("work_in_progress")),
        })
    review = [{
        "title": mr["title"],
        "url": mr["web_url"],
        "author": mr.get("author", {}).get("username", ""),
    } for mr in api(f"merge_requests?scope=all&state=opened&reviewer_username={quote(me)}&per_page=20")
        if mr.get("author", {}).get("username") != me]
    return {"ok": True, "host": HOST or "", "user": me, "mine": mine, "review": review}


if __name__ == "__main__":
    try:
        out = main()
    except Fail as e:
        out = {"ok": False, "error": str(e)}
    except (ValueError, KeyError) as e:
        out = {"ok": False, "error": f"unexpected answer from GitLab: {e}"}
    json.dump(out, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
