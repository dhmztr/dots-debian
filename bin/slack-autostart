#!/bin/sh
# Start Slack minimized to the tray once the bar's tray is up.
#
# Slack (Electron) looks for a StatusNotifierItem host only when it starts:
# if quickshell's tray (org.kde.StatusNotifierWatcher on the session bus) is
# not there yet, it falls back to the old XEmbed tray and the icon never shows
# up in the bar. So: wait for the watcher (up to 20 s), then start Slack.
# Does nothing when Slack is already running. xmonad's autostart runs it.
pgrep -x slack >/dev/null && exit 0
command -v slack >/dev/null || exit 0

has_watcher() {
    dbus-send --session --print-reply --dest=org.freedesktop.DBus \
        /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner \
        string:org.kde.StatusNotifierWatcher 2>/dev/null | grep -q 'boolean true'
}

i=0
until has_watcher || [ "$i" -ge 40 ]; do
    sleep 0.5
    i=$((i + 1))
done
sleep 1   # let the watcher settle before Slack registers
exec slack --startup   # --startup: start hidden in the tray
