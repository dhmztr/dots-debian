#!/bin/sh
# dunst runs this for every Slack notification (rule [slack] in dunstrc):
#   $1 appname  $2 summary  $3 body  $4 icon  $5 urgency
# It keeps "<count>\t<last sender>" in $XDG_RUNTIME_DIR/slack-unread; the
# Slack button on the bar shows the count and resets it when Slack gets focus.
f="${XDG_RUNTIME_DIR:-/tmp}/slack-unread"
n=$(cut -f1 "$f" 2>/dev/null)
case "$n" in ''|*[!0-9]*) n=0 ;; esac
printf '%s\t%s\n' "$((n + 1))" "$(printf '%s' "$2" | tr '\t\n' '  ')" > "$f.tmp" &&
    mv "$f.tmp" "$f"
