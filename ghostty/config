# Ghostty - same look as the NixOS setup, with a static palette instead of
# wallust. Change the colours here AND in ~/.cache/wal/colors-wal.vim (nvim)
# to keep both in sync (see README "Kolory").

font-family = Iosevka Nerd Font
font-family-bold = Iosevka Nerd Font
font-family-italic = Iosevka Nerd Font
font-family-bold-italic = Iosevka Nerd Font
font-size = 12

background-opacity = 0.9
window-decoration = none

cursor-style = block
cursor-style-blink = false


# --- palette (Rosé Pine, from wallust on the NixOS setup) ---
background = #191724
foreground = #e0def4
cursor-color = #e0def4

palette = 0=#26233a
palette = 1=#eb6f92
palette = 2=#9ccfd8
palette = 3=#f6c177
palette = 4=#3986a6
palette = 5=#c4a7e7
palette = 6=#ebbcba
palette = 7=#e0def4

palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=#9ccfd8
palette = 11=#f6c177
palette = 12=#3986a6
palette = 13=#c4a7e7
palette = 14=#ebbcba
palette = 15=#e0def4

resize-overlay = never
confirm-close-surface = false
gtk-single-instance = false
click-repeat-interval = 500
